# Windows: C:/Users/votre-nom/.codex
# macOS/Linux: /home/votre-nom/.codex
# Docker ne montera que sessions/, archived_sessions/ et session_index.jsonl.
# Ces trois sources doivent exister avant `docker compose up`.
CODEX_DATA_PATH=C:/Users/votre-nom/.codex

# Fréquence de réindexation en millisecondes.
REFRESH_INTERVAL_MS=60000

# Optionnel : synchroniser ce PC vers un hub Codex Usage Mesh.
# Le code est à usage unique et peut être retiré après le premier enrôlement réussi.
# MESH_HUB_URL=https://votre-site.example
# Site privé uniquement : jeton d’accès machine généré par OpenAI Sites.
# MESH_SITES_BYPASS_TOKEN=secret
# Facultatif : le nom système du PC est utilisé automatiquement si cette ligne est absente.
# MESH_NODE_ALIAS=PC Bureau
# MESH_ENROLLMENT_CODE=AAAA-BBBB-CCCC-DDDD
# MESH_AGENT_STATE_PATH=/app-cache/mesh-agent.json
# MESH_BATCH_SIZE=100
# MESH_PROJECT_MODE=hash
# MESH_INCLUDE_TITLES=false
