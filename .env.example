# Windows: C:/Users/votre-nom/.codex
# macOS/Linux: /home/votre-nom/.codex
# Docker ne montera que sessions/, archived_sessions/ et session_index.jsonl.
# Ces trois sources doivent exister avant `docker compose up`.
CODEX_DATA_PATH=C:/Users/votre-nom/.codex

# Fréquence de réindexation en millisecondes.
REFRESH_INTERVAL_MS=60000
